{
  "name": "mixr_api",
  "version": "0.0.35",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:prod": "bun run dist/index.js",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "lint": "bunx eslint src",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx prettier --write src",
    "format:check": "bunx prettier --check src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@sudobility/test-db-guard": "^1.0.3",
    "@types/bun": "latest",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "drizzle-kit": "~0.31.11",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "@hono/zod-validator": "~0.7.6",
    "@sudobility/mixr_types": "^0.0.30",
    "@sudobility/subscription_service": "^1.0.32",
    "@sudobility/types": "^1.9.76",
    "drizzle-orm": "~0.45.4",
    "firebase-admin": "~13.10.0",
    "hono": "~4.11.5",
    "openai": "~6.16.0",
    "postgres": "~3.4.9",
    "zod": "~4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/mixr_api.git"
  }
}
